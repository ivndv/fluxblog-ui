{
	"name": "blog-personal-fluxdev-frontend",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"dev:full": "bun run build && bunx wrangler pages dev dist/ --ip localhost --port 4321",
		"build": "astro build && pagefind --site dist --output-subdir pagefind-es --glob \"**/articulos/*/index.html\" && pagefind --site dist --output-subdir pagefind-en --glob \"**/en/blog/*/index.html\"",
		"preview": "astro preview",
		"astro": "astro",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@astrojs/react": "7.1.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "7.4.4",
		"hono": "4.13.14",
		"marked": "18.1.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.3",
		"zod": "4.6.7",
		"zustand": "5.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@inlang/paraglide-js": "^2.29.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "30.1.3",
		"pagefind": "^1.5.2",
		"typescript": "^7.0.2",
		"vitest": "5.0.5",
		"wrangler": "^4.156.0"
	}
}
