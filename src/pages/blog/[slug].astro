---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/payload";
import PostContent from "../../components/PostContent.astro";

export async function getStaticPaths() {
    const posts = await getPosts('es');
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;

const postDescription =
    post.excerpt ||
    post.content?.root?.children?.[0]?.children?.[0]?.text?.substring(0, 160) ||
    "";
---

<Layout title={post.title} description={postDescription}>
    <main class="max-w-3xl mx-auto px-6 py-12 md:py-20">
        <PostContent post={post} locale="es" />
    </main>
</Layout>
