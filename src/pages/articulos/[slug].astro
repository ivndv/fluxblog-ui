---
import BlogPostPage from '../../components/pages/BlogPostPage.astro';
import { getAllPosts } from '../../lib/payload';

export async function getStaticPaths() {
	const [esPosts, enPosts] = await Promise.all([
		getAllPosts('es'),
		getAllPosts('en'),
	]);

	const enSlugById = new Map(
		enPosts.map((post) => [String(post.id), post.slug]),
	);

	return esPosts.map((post) => ({
		params: { slug: post.slug },
		props: {
			post,
			alternateSlug: enSlugById.get(String(post.id)),
		},
	}));
}

const { post, alternateSlug } = Astro.props;
---

<BlogPostPage post={post} locale="es" alternateSlug={alternateSlug} />
