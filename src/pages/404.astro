---
import '../styles/global.css';
import * as m from '@/paraglide/messages';

const es = { locale: 'es' } as const;
const en = { locale: 'en' } as const;
const title = m.not_found_title({}, es);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/png" href="https://assets.mgdc.site/fluxblog/favicon.png" />
		<title>{title} | FluxDev</title>
		<script is:inline>
			try {
				const stored = localStorage.getItem('fluxblog-ui-store');
				const theme = stored ? JSON.parse(stored)?.state?.theme : null;
				if (theme === 'light') document.documentElement.classList.add('light');
			} catch {}
		</script>
	</head>
	<body data-pagefind-ignore class="bg-surface-base text-text-primary font-sans antialiased">
		<main class="flex min-h-screen items-center justify-center px-6">
			<div class="max-w-lg text-center">
				<p class="text-brand text-sm font-bold tracking-[0.3em] uppercase">404</p>

				<div data-lang-block="es">
					<h1 class="mt-4 text-3xl font-bold tracking-tight text-white md:text-4xl">
						{m.not_found_title({}, es)}
					</h1>
					<p class="mt-3 text-text-secondary">
						{m.not_found_description({}, es)}
					</p>
					<div class="mt-8 flex flex-wrap justify-center gap-3">
						<a
							href="/"
							class="rounded-button bg-white px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-neutral-200"
						>
							{m.not_found_home({}, es)}
						</a>
						<a
							href="/en/"
							class="rounded-button border border-border-subtle px-5 py-3 text-sm font-semibold text-text-secondary transition-colors hover:border-border-hover hover:text-white"
						>
							English
						</a>
					</div>
				</div>

				<div data-lang-block="en" class="hidden">
					<h1 class="mt-4 text-3xl font-bold tracking-tight text-white md:text-4xl">
						{m.not_found_title({}, en)}
					</h1>
					<p class="mt-3 text-text-secondary">
						{m.not_found_description({}, en)}
					</p>
					<div class="mt-8 flex flex-wrap justify-center gap-3">
						<a
							href="/en/"
							class="rounded-button bg-white px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-neutral-200"
						>
							{m.not_found_home({}, en)}
						</a>
						<a
							href="/"
							class="rounded-button border border-border-subtle px-5 py-3 text-sm font-semibold text-text-secondary transition-colors hover:border-border-hover hover:text-white"
						>
							Español
						</a>
					</div>
				</div>
			</div>
		</main>

		<script is:inline>
			const isEnglish = window.location.pathname.startsWith('/en');
			document.documentElement.lang = isEnglish ? 'en' : 'es';
			document.querySelectorAll('[data-lang-block]').forEach((element) => {
				element.classList.toggle(
					'hidden',
					element.dataset.langBlock !== (isEnglish ? 'en' : 'es'),
				);
			});
		</script>
	</body>
</html>
