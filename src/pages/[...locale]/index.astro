---
import Layout from "../../layouts/Layout.astro";
import HomeContent from "../../components/blog/HomeContent.astro";

export function getStaticPaths() {
	return [
		{ params: { locale: undefined } },
		{ params: { locale: "en" } },
	];
}

const { locale } = Astro.params;
const currentLocale: Locale = locale === "en" ? "en" : "es";
const title = currentLocale === "en" ? "Thoughts on Software" : "Fluxdev";
---

<Layout title={title} lang={currentLocale}>
	<main class="max-w-3xl mx-auto px-6 py-8 md:py-14">
		<HomeContent locale={currentLocale} />
	</main>
</Layout>
