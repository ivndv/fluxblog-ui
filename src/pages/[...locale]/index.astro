---
import * as m from '@/paraglide/messages';
import Layout from "../../layouts/Layout.astro";
import HomeContent from "../../components/blog/HomeContent.astro";
import { paths, type Locale } from "../../lib/routes";

export function getStaticPaths() {
	return [
		{ params: { locale: undefined } },
		{ params: { locale: "en" } },
	];
}

const { locale } = Astro.params;
const currentLocale: Locale = locale === "en" ? "en" : "es";
const title = m.nav_home({}, { locale: currentLocale });

const siteUrl = Astro.site ?? new URL("https://fluxblog.liuma.app");
const searchUrl = new URL(paths.search(currentLocale), siteUrl).toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "FluxDev",
	url: new URL(paths.home(currentLocale), siteUrl).toString(),
	inLanguage: currentLocale === "es" ? "es-MX" : "en-US",
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: `${searchUrl}?q={search_term_string}`,
		},
		"query-input": "required name=search_term_string",
	},
};
---

<Layout title={title} lang={currentLocale} jsonLd={jsonLd}>
	<main class="px-6">
		<HomeContent locale={currentLocale} />
	</main>
</Layout>
