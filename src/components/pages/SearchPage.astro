---
import * as m from '@/paraglide/messages';
import type { Locale } from '../../lib/routes';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const opt = { locale };

const bundlePath = locale === 'es' ? '/pagefind-es/' : '/pagefind-en/';

const translations = {
	placeholder: m.search_placeholder({}, opt),
	clear_search: m.search_clear({}, opt),
	load_more: m.search_load_more({}, opt),
	zero_results: m.search_zero_results({}, opt),
	one_result: m.search_one_result({}, opt),
	many_results: m.search_many_results({}, opt),
	searching: m.search_searching({}, opt),
	search_label: m.search_label({}, opt),
};
---

<section>
	<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white">
		{m.search_title({}, opt)}
	</h1>

	<p class="mt-3 max-w-2xl text-base text-text-secondary leading-relaxed">
		{m.search_description({}, opt)}
	</p>

	<div id="search" class="mt-8"></div>

	<p
		id="search-unavailable"
		class="mt-8 hidden rounded-2xl border border-border-subtle bg-surface-raised p-6 text-sm text-text-muted"
	>
		{m.search_unavailable({}, opt)}
	</p>

	<noscript>
		<p class="mt-8 rounded-2xl border border-border-subtle bg-surface-raised p-6 text-sm text-text-muted">
			{m.search_noscript({}, opt)}
		</p>
	</noscript>
</section>

<script is:inline define:vars={{ bundlePath, translations }}>
	(function () {
		function showUnavailable() {
			document.getElementById('search-unavailable')?.classList.remove('hidden');
		}

		function ensureStyles() {
			if (document.querySelector('link[data-pagefind-css]')) return;
			const link = document.createElement('link');
			link.rel = 'stylesheet';
			link.href = bundlePath + 'pagefind-ui.css';
			link.dataset.pagefindCss = 'true';
			document.head.appendChild(link);
		}

		function render() {
			const container = document.getElementById('search');
			if (!container || container.dataset.ready === 'true') return;
			if (typeof window.PagefindUI === 'undefined') {
				showUnavailable();
				return;
			}

			container.dataset.ready = 'true';
			container.innerHTML = '';

			new window.PagefindUI({
				element: '#search',
				bundlePath: bundlePath,
				showSubResults: true,
				translations: translations,
			});

			const query = new URLSearchParams(window.location.search).get('q');
			if (query) {
				const input = container.querySelector('input.pagefind-ui__search-input');
				if (input) {
					input.value = query;
					input.dispatchEvent(new Event('input', { bubbles: true }));
				}
			}
		}

		function load() {
			const container = document.getElementById('search');
			if (!container) return;

			ensureStyles();

			if (window.PagefindUI) {
				render();
				return;
			}

			const existing = document.querySelector('script[data-pagefind-js]');
			if (existing) {
				existing.addEventListener('load', render, { once: true });
				return;
			}

			const script = document.createElement('script');
			script.src = bundlePath + 'pagefind-ui.js';
			script.dataset.pagefindJs = 'true';
			script.addEventListener('load', render, { once: true });
			script.addEventListener('error', showUnavailable, { once: true });
			document.head.appendChild(script);
		}

		document.addEventListener('astro:page-load', load);
		if (document.readyState !== 'loading') load();
	})();
</script>
