---
import * as m from '@/paraglide/messages';
import type { PayloadPost } from '../../lib/payload';
import { paths, type Locale } from '../../lib/routes';
import FadeIn from '../ui/animations/FadeIn.astro';
import Pagination from '../blog/Pagination.astro';
import PostCard from '../blog/PostCard.astro';
import TagPill from '../blog/TagPill.astro';

interface Props {
	posts: PayloadPost[];
	locale: Locale;
	currentPage: number;
	totalPages: number;
	tags: string[];
}

const { posts, locale, currentPage, totalPages, tags } = Astro.props;
const opt = { locale };
---

<header class="mb-10">
	<FadeIn direction="up">
		<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white">
			{m.blog_title({}, opt)}
		</h1>
	</FadeIn>

	<FadeIn direction="up" delay={40}>
		<p class="mt-3 max-w-2xl text-base text-text-secondary leading-relaxed">
			{m.blog_description({}, opt)}
		</p>
	</FadeIn>
</header>

{
	tags.length > 0 && (
		<div class="mb-8 flex flex-wrap items-center gap-2">
			<a
				href={paths.blog(locale)}
				class="rounded-full border border-brand/40 bg-brand/10 px-3 py-1 text-xs font-bold text-brand transition-colors"
			>
				{m.blog_all_tags({}, opt)}
			</a>
			{tags.map((tag) => (
				<TagPill tag={tag} href={paths.tag(locale, tag)} />
			))}
		</div>
	)
}

{
	posts.length > 0 ? (
		<>
			<section class="space-y-5">
				{posts.map((post, index) => (
					<PostCard
						post={post}
						locale={locale}
						delay={Math.min(index * 40, 160)}
					>
						<Fragment slot="read-more">{m.home_read_more({}, opt)}</Fragment>
					</PostCard>
				))}
			</section>
			<Pagination
				currentPage={currentPage}
				totalPages={totalPages}
				locale={locale}
			/>
		</>
	) : (
		<p class="rounded-2xl border border-border-subtle bg-surface-raised p-6 text-sm text-text-muted">
			{m.home_empty({}, opt)}
		</p>
	)
}
