---
import type { PayloadPost } from "../lib/payload";
import FadeIn from "./animations/FadeIn.astro";
import IconArrowLeft from "./icons/IconArrowLeft.astro";
import LexicalRenderer from "./LexicalRenderer.astro";
import { getDictionary, type Locale } from "../i18n/dictionary";

interface Props {
	post: PayloadPost;
	locale: Locale;
}

const { post, locale } = Astro.props;
const t = getDictionary(locale);

const readingTime = `5 ${t.post.readingTime}`;
const dateLocale = locale === 'en' ? 'en-US' : 'es-MX';
const formatDate = (date: string) =>
    new Date(date).toLocaleDateString(dateLocale, {
        day: "2-digit",
        month: "short",
        year: "numeric",
    });
const postDescription =
    post.excerpt ||
    post.content?.root?.children?.[0]?.children?.[0]?.text?.substring(0, 160) ||
    "";

const backUrl = locale === 'en' ? '/en' : '/';
const blogUrl = locale === 'en' ? '/en/blog' : '/blog';
---

<nav class="mb-12">
    <FadeIn direction="left" duration={0.4}>
        <a
            href={backUrl}
            class="group inline-flex items-center text-sm font-bold tracking-widest uppercase text-text-muted hover:text-white"
        >
            <IconArrowLeft class="w-4 h-4 mr-3 group-hover:-translate-x-1 transition-transform" />
            {t.post.back}
        </a>
    </FadeIn>
</nav>

<header class="mb-16">
    <FadeIn direction="up" delay={200}>
        <h1
            class="text-4xl md:text-6xl font-extrabold tracking-tighter leading-tight mb-8 text-text-heading"
        >
            {post.title}
        </h1>
    </FadeIn>

    <FadeIn direction="up" delay={400}>
        <div class="flex flex-wrap items-center gap-6 pt-2 border-t border-border-subtle/30 mt-8">
            <div class="flex items-center gap-3">
                <div
                    class="w-10 h-10 rounded-full bg-surface-hover flex items-center justify-center font-black text-xs border border-white/5"
                >
                    FD
                </div>
                <div class="text-sm">
                    <p class="font-bold text-text-primary">
                        {post.author?.name || t.post.defaultAuthor}
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 text-xs font-bold tracking-widest uppercase text-text-muted">
                <span class="w-1 h-1 bg-border-muted rounded-full"></span>
                <span>{formatDate(post.date || post.createdAt)}</span>
                <span class="w-1 h-1 bg-border-muted rounded-full"></span>
                <span class="italic">{readingTime}</span>
            </div>
        </div>
    </FadeIn>
</header>

<FadeIn direction="up" delay={800}>
    <article class="article-content max-w-none">
        <LexicalRenderer nodes={post.content?.root?.children || []} />
    </article>
</FadeIn>
