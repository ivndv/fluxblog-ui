---
import * as m from '@/paraglide/messages';
import { getMediaUrl, type PayloadPost } from "../../lib/payload";
import {
	formatDate,
	getHeadings,
	getReadingTime,
} from "../../lib/post-utils";
import { paths, type Locale } from "../../lib/routes";
import FadeIn from "../ui/animations/FadeIn.astro";
import IconArrowLeft from "../ui/icons/IconArrowLeft.astro";
import AuthorCard from "./AuthorCard.astro";
import LexicalRenderer from "./LexicalRenderer.astro";
import ShareLinks from "./ShareLinks.astro";
import TableOfContents from "./TableOfContents.astro";

interface Props {
	post: PayloadPost;
	locale: Locale;
}

const { post, locale } = Astro.props;
const opt = { locale };

const readingTime = getReadingTime(post);
const headings = getHeadings(post.content?.root?.children);
const coverUrl = getMediaUrl(post.featuredImage);
const publishedAt = formatDate(post.date || post.createdAt, locale);

const backUrl = paths.blog(locale);
const shareOrigin = import.meta.env.DEV
	? Astro.url.origin
	: (Astro.site?.origin ?? Astro.url.origin);
const shareUrl = new URL(paths.post(locale, post.slug), shareOrigin).toString();

const authorName = m.about_name({}, opt);
const authorInitials = authorName
	.split(' ')
	.map((part) => part[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
---

<nav class="mb-8">
    <FadeIn direction="left">
        <a
            href={backUrl}
            class="group inline-flex items-center text-xs font-bold tracking-widest uppercase text-text-muted hover:text-white transition-colors"
        >
            <IconArrowLeft class="w-3.5 h-3.5 mr-2 group-hover:-translate-x-1 transition-transform" />
            {m.post_back({}, opt)}
        </a>
    </FadeIn>
</nav>

<header class="mb-10">
    {post.tags && post.tags.length > 0 && (
        <FadeIn direction="up">
            <div class="flex flex-wrap gap-2 mb-4">
                {post.tags.map((tag) => (
                    <a
                        href={paths.tag(locale, tag.value)}
                        class="text-xs font-bold text-brand tracking-wider uppercase hover:text-brand-hover transition-colors"
                    >
                        #{tag.value}
                    </a>
                ))}
            </div>
        </FadeIn>
    )}

    <FadeIn direction="up" delay={40}>
        <h1
            class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-white mb-6"
        >
            {post.title}
        </h1>
    </FadeIn>

    <FadeIn direction="up" delay={80}>
        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-border-subtle text-xs text-text-muted">
            <div class="flex items-center gap-2.5">
                <div
                    class="w-7 h-7 rounded-full bg-surface-hover flex items-center justify-center font-bold text-[10px] text-white border border-white/10"
                >
                    {authorInitials}
                </div>
                <span class="font-semibold text-text-primary">
                    {authorName}
                </span>
            </div>

            <span class="w-1 h-1 bg-border-muted rounded-full"></span>
            <span>{publishedAt}</span>
            <span class="w-1 h-1 bg-border-muted rounded-full"></span>
            <span class="italic">{readingTime} {m.post_reading_time({}, opt)}</span>
        </div>

        <div class="mt-5">
            <ShareLinks url={shareUrl} title={post.title} locale={locale} />
        </div>
    </FadeIn>
</header>

{coverUrl && (
    <FadeIn direction="up" delay={80}>
        <img
            src={coverUrl}
            alt={post.title}
            class="mb-10 aspect-video w-full rounded-2xl border border-border-subtle object-cover"
            loading="eager"
        />
    </FadeIn>
)}

<TableOfContents headings={headings} locale={locale} />

<FadeIn direction="up" delay={80}>
    <article class="article-content max-w-none" data-pagefind-body>
        <LexicalRenderer nodes={post.content?.root?.children || []} />
    </article>
</FadeIn>

<AuthorCard locale={locale} />
