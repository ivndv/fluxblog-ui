---
import * as m from '@/paraglide/messages';
import { localizeHref } from '@/paraglide/runtime';
import { getPosts } from "../../lib/payload";
import FadeIn from "../ui/animations/FadeIn.astro";
import IconArrowRight from "../ui/icons/IconArrowRight.astro";

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const opt = { locale };

const posts = await getPosts(locale);

// Extraer tags únicos de todos los posts
const popularTags = [
	...new Set(posts.flatMap((p) => (p.tags ?? []).map((t) => t.value))),
].sort();

const dateFormatLocale = locale === 'en' ? 'en-US' : 'es-ES';
---

<header class="mb-14">
	<!-- Badge superior -->
	<FadeIn direction="up">
		<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-raised border border-border-subtle text-xs font-semibold text-text-muted mb-5">
			<span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
			<span>{m.home_badge({}, opt)}</span>
		</div>
	</FadeIn>

	<FadeIn direction="up" delay={40}>
		<h1
			class="text-3xl md:text-4xl font-bold tracking-tight leading-snug text-white max-w-2xl"
		>
			Desarrollo de software, tutoriales y <span class="text-brand">{locale === 'en' ? 'a bit about me.' : 'un poco de mí.'}</span>
		</h1>
	</FadeIn>
	
	<FadeIn direction="up" delay={80}>
		<p
			class="text-base text-text-secondary leading-relaxed max-w-2xl mt-4 mb-8"
		>
			{m.home_description({}, opt)}
		</p>
	</FadeIn>

	<!-- Temas populares -->
	<FadeIn direction="up" delay={100}>
		<div class="pt-2">
			<p
				class="text-xs font-bold tracking-widest uppercase text-text-muted mb-4"
			>
				{m.home_popular_topics({}, opt)}
			</p>
			<div class="flex flex-wrap gap-2">
				{
					popularTags.length > 0 ? (
						popularTags.map((tag) => (
							<span class="px-4 py-1.5 text-sm rounded-full border border-border-subtle text-text-muted hover:border-brand hover:text-brand transition-colors cursor-pointer">
								#{tag}
							</span>
						))
					) : (
						<span class="text-sm text-text-faint italic">
							{m.home_no_tags({}, opt)}
						</span>
					)
				}
			</div>
		</div>
	</FadeIn>
</header>

<hr class="border-border-subtle mb-10 opacity-50" />

<section class="space-y-6">
	{
		posts.map((post, index) => {
			const postHref = localizeHref(`/blog/${post.slug}`, opt);
			return (
				<FadeIn 
					direction="up" 
					delay={Math.min(index * 40, 160)}
					class="block w-full"
				>
					<article class="group relative rounded-2xl bg-surface-raised border border-border-subtle hover:bg-surface-hover hover:border-border-hover hover:-translate-y-0.5 transition-all duration-normal ease-out p-6 md:p-7">
						<div class="flex flex-col gap-3.5">
							<div class="flex items-center gap-3 text-xs font-semibold text-text-muted">
								{
									(post.tags ?? []).length > 0 && (
										<>
											<div class="flex gap-2">
												{post.tags.map((t) => (
													<span class="text-brand font-bold">
														#{t.value}
													</span>
												))}
											</div>
											<span class="w-1 h-1 bg-border-muted rounded-full" />
										</>
									)
								}
								<span>
									{new Date(
										post.date || post.createdAt,
									).toLocaleDateString(dateFormatLocale, {
										day: "2-digit",
										month: "short",
										year: "numeric",
									})}
								</span>
							</div>

							<a
								href={postHref}
								class="block"
							>
								<h2 class="text-xl md:text-2xl font-bold text-text-primary group-hover:text-brand transition-colors duration-normal">
									{post.title}
								</h2>
							</a>

							<p class="text-sm md:text-base text-text-secondary leading-relaxed line-clamp-2">
								{post.excerpt ||
									post.content?.root?.children?.[0]?.children?.[0]?.text?.substring(
										0,
										140,
									) + "..." ||
									m.home_no_description({}, opt)}
							</p>

							<div class="pt-1">
								<a
									href={postHref}
									class="inline-flex items-center text-xs font-bold text-text-primary hover:text-brand group/link transition-colors"
								>
									{m.home_read_more({}, opt)}
									<IconArrowRight class="w-3.5 h-3.5 ml-1.5 group-hover/link:translate-x-1 transition-transform" />
								</a>
							</div>
						</div>
					</article>
				</FadeIn>
			);
		})
	}
</section>
