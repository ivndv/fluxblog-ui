---
import { getMediaUrl, type PayloadPost } from "../../lib/payload";
import { formatDate, getExcerpt } from "../../lib/post-utils";
import { paths, type Locale } from "../../lib/routes";
import FadeIn from "../ui/animations/FadeIn.astro";
import IconArrowRight from "../ui/icons/IconArrowRight.astro";

interface Props {
	post: PayloadPost;
	locale: Locale;
	delay?: number;
}

const { post, locale, delay = 0 } = Astro.props;

const postHref = paths.post(locale, post.slug);
const excerpt = getExcerpt(post);
const publishedAt = formatDate(post.date || post.createdAt, locale);
const tags = post.tags ?? [];
const coverUrl = getMediaUrl(post.featuredImage);
const coverAlt =
	typeof post.featuredImage === 'object' && post.featuredImage?.alt
		? post.featuredImage.alt
		: post.title;
---

<FadeIn direction="up" delay={delay} class="block w-full">
	<article
		class="group relative rounded-2xl bg-surface-raised border border-border-subtle hover:bg-surface-hover hover:border-border-hover hover:-translate-y-0.5 transition-all duration-normal ease-out p-6 md:p-7"
	>
		{
			coverUrl && (
				<a
					href={postHref}
					class="mb-5 block overflow-hidden rounded-xl border border-border-subtle"
				>
					<img
						src={coverUrl}
						alt={coverAlt}
						loading="lazy"
						class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
					/>
				</a>
			)
		}

		<div class="flex flex-col gap-3.5">
			<div class="flex items-center gap-3 text-xs font-semibold text-text-muted">
				{
					tags.length > 0 && (
						<>
							<div class="flex gap-2">
								{tags.map((tag) => (
									<span class="text-brand font-bold">#{tag.value}</span>
								))}
							</div>
							<span class="w-1 h-1 bg-border-muted rounded-full" />
						</>
					)
				}
				<span>{publishedAt}</span>
			</div>

			<a href={postHref} class="block">
				<h2 class="text-lg md:text-xl font-bold text-text-primary group-hover:text-brand transition-colors duration-normal">
					{post.title}
				</h2>
			</a>

			<p class="text-sm text-text-secondary leading-relaxed line-clamp-2">
				{excerpt}
			</p>

			<div class="pt-1">
				<a
					href={postHref}
					class="inline-flex items-center text-xs font-bold text-text-primary hover:text-brand group/link transition-colors"
				>
					<slot name="read-more" />
					<IconArrowRight class="w-3.5 h-3.5 ml-1.5 group-hover/link:translate-x-1 transition-transform" />
				</a>
			</div>
		</div>
	</article>
</FadeIn>
