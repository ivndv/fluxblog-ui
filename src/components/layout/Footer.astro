---
import * as m from '@/paraglide/messages';
import { paths, type Locale } from '../../lib/routes';
import IconInstagram from '../ui/icons/IconInstagram.astro';
import IconYoutube from '../ui/icons/IconYoutube.astro';
import IconGithub from '../ui/icons/IconGithub.astro';

const currentYear = new Date().getFullYear();
const currentLocale: Locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const opt = { locale: currentLocale };

const siteName = 'FluxDev';
const socials = [
	{ platform: 'instagram', url: 'https://instagram.com' },
	{ platform: 'youtube', url: 'https://youtube.com' },
	{ platform: 'github', url: 'https://github.com/ivangtx19' },
];
---

<footer data-pagefind-ignore class="border-t border-border-subtle mt-auto pt-16 pb-8">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
        <!-- 3-column grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
            <!-- Brand & Social -->
            <div class="flex flex-col gap-4">
                <a href={paths.home(currentLocale)} class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-white flex items-center justify-center">
                        <div class="w-1 h-1 bg-black rounded-full"></div>
                    </div>
                    <span class="text-lg font-bold tracking-[0.15em] uppercase text-white">
                        {siteName}
                    </span>
                </a>
                <p class="text-sm text-text-faint leading-relaxed max-w-xs">
                    {m.footer_tagline({}, opt)}
                </p>
                <div class="flex gap-4 mt-2">
                    {socials.map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={social.platform}
                            class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text-muted transition-colors hover:bg-surface-raised hover:text-white"
                        >
                            {social.platform === 'github' && <IconGithub class="h-5 w-5" />}
                            {social.platform === 'instagram' && <IconInstagram class="h-5 w-5" />}
                            {social.platform === 'youtube' && <IconYoutube class="h-5 w-5" />}
                        </a>
                    ))}
                </div>
            </div>

            <!-- Navigation -->
            <div class="flex flex-col gap-4">
                <h3 class="font-bold text-white uppercase tracking-wider text-sm">
                    {m.footer_navigation({}, opt)}
                </h3>
                <ul class="flex flex-col gap-3 text-sm text-text-muted">
                    <li>
                        <a href={paths.home(currentLocale)} class="hover:text-white transition-colors"
                            >{m.nav_home({}, opt)}</a
                        >
                    </li>
                    <li>
                        <a href={paths.blog(currentLocale)} class="hover:text-white transition-colors"
                            >{m.nav_posts({}, opt)}</a
                        >
                    </li>
                    <li>
                        <a href={paths.about(currentLocale)} class="hover:text-white transition-colors"
                            >{m.nav_about({}, opt)}</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Legal -->
            <div class="flex flex-col gap-4">
                <h3 class="font-bold text-white uppercase tracking-wider text-sm">
                    {m.footer_legal({}, opt)}
                </h3>
                <ul class="flex flex-col gap-3 text-sm text-text-muted">
                    <li>
                        <a
                            href={paths.legal(currentLocale, 'terms')}
                            class="hover:text-white transition-colors"
                            >{m.footer_terms({}, opt)}</a
                        >
                    </li>
                    <li>
                        <a
                            href={paths.legal(currentLocale, 'privacy')}
                            class="hover:text-white transition-colors"
                            >{m.footer_privacy({}, opt)}</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-border-subtle pt-8 flex flex-col items-center gap-4">
            <p class="text-sm font-medium text-text-muted">
                {m.footer_developed_by({}, opt)} <span class="font-bold text-white">Sinx</span>
            </p>
            <p class="text-xs text-text-faint">
                © {currentYear} {siteName}. {m.footer_all_rights_reserved({}, opt)}
            </p>
        </div>
    </div>
</footer>
