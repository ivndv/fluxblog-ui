---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	lang?: string;
}

const {
	title,
	description = "Notas personales sobre arquitecturas, desarrollo web moderno y productos digitales.",
	image = "https://assets.mgdc.site/fluxblog/og-default.png",
	lang = "es",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image.startsWith("http") ? image : new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="https://assets.mgdc.site/fluxblog/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />

		<!-- SEO -->
		<title>{title} | FluxDev</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL.toString()} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.toString()} />
		<meta property="og:title" content={`${title} | FluxDev`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL.toString()} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="FluxDev Blog" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | FluxDev`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL.toString()} />

		<!-- RSS -->
		<link
			rel="alternate"
			type="application/rss+xml"
			title="FluxDev Blog"
			href="/rss.xml"
		/>

		<!-- Anti-FOUC & View Transitions Theme Sync -->
		<script is:inline>
			const getStoredTheme = () => {
				try {
					const stored = localStorage.getItem("fluxblog-ui-store");
					if (stored) {
						const parsed = JSON.parse(stored);
						if (parsed?.state?.theme) return parsed.state.theme;
					}
				} catch (e) {}
				return localStorage.getItem("theme") || "dark";
			};

			const syncTheme = () => {
				const theme = getStoredTheme();
				if (theme === "light") {
					document.documentElement.classList.add("light");
				} else {
					document.documentElement.classList.remove("light");
				}
			};

			syncTheme();
			document.addEventListener("astro:after-swap", syncTheme);
		</script>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
