---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { translatePath } from "../lib/routes";

interface Props {
	title: string;
	description?: string;
	image?: string;
	lang?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	alternates?: Array<{ hreflang: string; href: string }>;
	searchable?: boolean;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description = "Notas personales sobre arquitecturas, desarrollo web moderno y productos digitales.",
	image = "https://assets.liuma.app/fluxblog/og-default.png",
	lang = "es",
	type = "website",
	publishedTime,
	alternates: providedAlternates = [],
	searchable = false,
	jsonLd,
} = Astro.props;

const alternates =
	providedAlternates.length > 0
		? providedAlternates
		: [
				{ hreflang: "es", href: translatePath(Astro.url.pathname, "es") },
				{ hreflang: "en", href: translatePath(Astro.url.pathname, "en") },
			];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageURL = image.startsWith("http") ? image : new URL(image, Astro.site ?? Astro.url.origin).toString();
const ogLocale = lang === "en" ? "en_US" : "es_MX";
const rssHref = lang === "en" ? "/en/rss.xml" : "/rss.xml";
const absoluteUrl = (href: string) =>
	new URL(href, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="https://assets.liuma.app/fluxblog/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />

		<!-- SEO -->
		<title>{title} | FluxDev</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL.toString()} />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL.toString()} />
		<meta property="og:title" content={`${title} | FluxDev`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL.toString()} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:site_name" content="FluxDev Blog" />
		{type === "article" && publishedTime && (
			<meta property="article:published_time" content={publishedTime} />
		)}

		<!-- Language alternates -->
		{alternates.map((alternate) => (
			<link
				rel="alternate"
				hreflang={alternate.hreflang}
				href={absoluteUrl(alternate.href)}
			/>
		))}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | FluxDev`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL.toString()} />
		<meta name="twitter:image:alt" content={title} />

		<!-- RSS -->
		<link
			rel="alternate"
			type="application/rss+xml"
			title="FluxDev Blog"
			href={rssHref}
		/>

		<slot name="head" />

		{jsonLd && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
			/>
		)}

		<!-- Anti-FOUC & View Transitions Theme Sync -->
		<script is:inline>
			const getStoredTheme = () => {
				try {
					const stored = localStorage.getItem("fluxblog-ui-store");
					if (stored) {
						const parsed = JSON.parse(stored);
						if (parsed?.state?.theme) return parsed.state.theme;
					}
				} catch (e) {}
				return localStorage.getItem("theme") || "dark";
			};

			const syncTheme = () => {
				const theme = getStoredTheme();
				if (theme === "light") {
					document.documentElement.classList.add("light");
				} else {
					document.documentElement.classList.remove("light");
				}
			};

			syncTheme();
			document.addEventListener("astro:after-swap", syncTheme);
		</script>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Umami Analytics -->
		<script
			defer
			src="https://umami.liuma.app/script.js"
			data-website-id="6404a796-0d97-46b6-9f02-4a9239f1866e"
		></script>
	</head>
	<body data-pagefind-ignore={searchable ? undefined : ""}>
		<Header />
		<slot />
		<Footer />
		<!-- Cloudflare Web Analytics -->
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon='{"token":"591849978fe34335acb7fb722ff840ef"}'
		></script>
		<!-- End Cloudflare Web Analytics -->
	</body>
</html>
